# HANSAN — Environment Placeholders (§26)
# NEVER commit real secrets. `.env.example` holds placeholders ONLY.
# Copy to `.env.local` (gitignored) and fill with real values for your project.
#
# Variable NAMES below mirror what src/config/environment.ts and
# prisma/schema.prisma actually read — keep them in sync if code changes.

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=HANSAN
NEXT_PUBLIC_APP_ENV=development

# ── Supabase — public/browser-safe (client bundle may include these) ────
# Publishable key = the modern name for the legacy "anon" key.
# environment.ts reads NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY first, then
# falls back to the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy fallback (optional)

# ── Supabase — server-only (NEVER expose to the client bundle) ─────────
# The secret/service-role key is privileged: do NOT prefix it with
# NEXT_PUBLIC_ and do NOT import it from client components.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Database — PostgreSQL via Supabase (Prisma) ────────────────────────
# DATABASE_URL  → transaction pooler (host ...pooler.supabase.com, port 6543)
# DIRECT_URL    → direct/session connection (host ...pooler.supabase.com, port 5432)
# Both point to the SAME database; DIRECT_URL is used only for migrations/admin.
DATABASE_URL=postgresql://<user>@<pooler-host>:6543/postgres
DIRECT_URL=postgresql://<user>@<pooler-host>:5432/postgres

# ── Session signing (server-only; >=32 chars in production) ────────────
# Interim demo-session signing secret. In development the app uses a
# published non-secret fallback; production WITHOUT this fails closed (503).
SESSION_SECRET=

# ── Provisioning (server-only; optional, reserved) ─────────────────────
# HANSAN_PROVISION_SECRET=
# HANSAN_DEVELOPER_PROVISION_SECRET=

# ── POS tax (server; 0–100, 0 = not configured) ────────────────────────
# POS_TAX_PERCENT=0

# ── Payments / integrations (reserved) ─────────────────────────────────
# QRIS_API_KEY=
# EDC_CONFIG=
